# =============================================
# KickZone — variables pour docker-compose
# Copier en .env à la racine : cp .env.example .env
# =============================================

# --- JWT ---
JWT_SECRET=change_me_to_a_long_random_string_min_32_chars
JWT_EXPIRES_IN=7d

# --- CORS : URL publique du front ---
ALLOWED_ORIGINS=https://kickzone.example.com

# --- Compte admin (seed) ---
ADMIN_EMAIL=admin@kickzone.fr
ADMIN_PASSWORD=Admin2026!

# --- API Football (api-sports.io) ---
FOOTBALL_API_KEY=
