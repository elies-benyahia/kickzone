# --- Serveur ---
PORT=3001
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173

# --- Base de données (SQLite : fichier local, aucune installation) ---
DB_FILE=./database/kickzone.db

# --- JWT (min. 32 caractères) ---
JWT_SECRET=change_me_to_a_long_random_string_min_32_chars
JWT_EXPIRES_IN=7d

# --- Compte admin créé par le seed ---
ADMIN_EMAIL=admin@kickzone.fr
ADMIN_PASSWORD=Admin2026!

# --- API Football (api-sports.io) — https://dashboard.api-football.com ---
# Sans clé, les pages football affichent "aucune donnée" (le site reste fonctionnel).
FOOTBALL_API_KEY=
